# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Discord webhook URL — legacy fallback alert (no button) used only if the bot
# below isn't configured. Create one via a Discord channel's
# Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=

# Discord bot — posts the interest alert WITH a "Send Confirmation Email"
# button (a plain webhook can't route button clicks anywhere). If both this
# and DISCORD_BOT_TOKEN/DISCORD_CHANNEL_ID are set, the bot takes priority.
# See README "Discord bot" section for setup steps.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Resend API key (resend.com) used to send the acknowledgment email when you
# click "Send Confirmation Email" on a Discord alert. Free tier: 3,000/month.
RESEND_API_KEY=

# From-address for confirmation emails. Requires verifying the domain in
# Resend's dashboard (SPF/DKIM DNS records) before this address can send.
EMAIL_FROM=PreorderCards <admin@preordercards.com>

# Signing secret for Resend's delivery-event webhooks (bounces, etc.) —
# powers the yellow "bounced" status dot on the marketplace admin panel's
# Discount Signups tab. Get this by adding a webhook in Resend's dashboard
# pointing at https://<your-domain>/api/webhooks/resend, subscribed to at
# least the "email.bounced" event — Resend shows the signing secret
# (starts with "whsec_") when you create it.
RESEND_WEBHOOK_SECRET=

# Shared secret protecting POST /api/seller/admin/generate-keys (mints new
# seller invite keys against the live DB without needing host shell access).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=

# Discord webhook for marketplace buyer-interest alerts specifically —
# separate from DISCORD_WEBHOOK_URL/the bot, which only handle release
# interest registrations. Create one via a Discord channel's
# Settings > Integrations > Webhooks.
MARKETPLACE_DISCORD_WEBHOOK_URL=

# Discord webhook for verified-seller applications submitted from
# /verified-seller.html — includes the applicant's StockX screenshot as an
# attachment. Create one via a Discord channel's Settings > Integrations >
# Webhooks.
VERIFIED_SELLER_WEBHOOK_URL=

# Anthropic API key (console.anthropic.com) — used by both blog paths: the
# weekly blog agent that writes and publishes a post on its own, and
# POST /api/admin/generate-blog-draft, which drafts a post and hands back
# ready-to-save source. Without this both no-op; the rest of the site is
# unaffected. Roughly a cent or two per post.
ANTHROPIC_API_KEY=

# Discord webhook the blog agent posts to when a new post goes live —
# includes the post link and the ready-to-copy tweet. Falls back to
# DISCORD_WEBHOOK_URL if unset.
BLOG_AGENT_WEBHOOK_URL=

# Public base URL of the site, used to build the post link in the tweet the
# blog agent hands you. Defaults to https://preordercards.com.
SITE_URL=https://preordercards.com

# --- Weekly newsletter (see README "Weekly newsletter") ---

# Arms the Sunday/Monday schedule. Left unset, issues can still be previewed
# and test-sent but nothing is ever mailed automatically — flip this to true
# only once you've previewed an issue and sent yourself a test.
NEWSLETTER_ENABLED=false

# Signs the per-recipient unsubscribe and click-tracking links. Falls back to
# ADMIN_SECRET if unset; sending is refused when neither is set, since every
# email needs a working unsubscribe link.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NEWSLETTER_SECRET=

# Which collected addresses get the weekly send. "signups" (default) is the
# consented marketing list — the homepage banner and /newsletter.html forms,
# both of which say the address is used for newsletters. "all" additionally
# includes people who only registered interest in a specific release.
NEWSLETTER_AUDIENCE=signups

# Local hour (America/New_York) both cohorts go out at — the send day is the
# only variable in the A/B test, so the hour is shared. Leave it later than
# the blog agent's own hour, which writes the post the email links to.
NEWSLETTER_SEND_HOUR=10

# Per-run send ceiling and the pause between messages, to stay inside
# Resend's rate and monthly limits. A run that hits the ceiling resumes on
# the next 5-minute tick within the same send hour.
NEWSLETTER_MAX_PER_RUN=500
NEWSLETTER_SEND_DELAY_MS=150

# Changing this re-draws the Sunday/Monday cohorts. Leave it alone while a
# test is running — the split has to stay stable for the comparison to mean
# anything.
NEWSLETTER_AB_SALT=
